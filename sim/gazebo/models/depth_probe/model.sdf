<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- the cameras of x500_dronerl without the drone; keep the two in sync -->
  <model name="depth_probe">
    <static>true</static>
    <link name="camera_link">
      <sensor name="rgb" type="camera">
        <camera>
          <horizontal_fov>1.745329</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>probe/image</topic>
      </sensor>
      <sensor name="depth" type="depth_camera">
        <camera>
          <horizontal_fov>1.745329</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>probe/depth/image</topic>
      </sensor>
    </link>
  </model>
</sdf>
