<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_dronerl">
    <include merge="true">
      <uri>x500_flow</uri>
    </include>
    <!-- 20 cm ahead and 5 cm below base_link the propellers stay out of the 100 deg view -->
    <link name="camera_link">
      <pose relative_to="base_link">0.2 0 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="housing">
        <pose>-0.015 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.06 0.03</size>
          </box>
        </geometry>
      </visual>
      <sensor name="rgb" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.745329</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
          <camera_info_topic>camera/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>camera/image</topic>
      </sensor>
      <!-- depth along the optical axis, the reference for the gz_depth condition and the parity test -->
      <sensor name="depth" type="depth_camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.745329</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
          <camera_info_topic>camera/depth/camera_info</camera_info_topic>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>camera/depth/image</topic>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
    <!-- ground truth for the flight monitor and system identification, on topics PX4 does not read -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>ground_truth/odometry</odom_topic>
      <odom_covariance_topic>ground_truth/odometry_with_covariance</odom_covariance_topic>
      <tf_topic>ground_truth/tf</tf_topic>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </model>
</sdf>
